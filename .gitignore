# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
# Widget Preview related
.widget_preview/

# Build output and Gradle caches of the vendored plugin in packages/.
# Gradle writes these next to the plugin sources when building the app.
/packages/*/android/.gradle/
/packages/*/android/build/
/packages/*/build/
/packages/*/.dart_tool/

# JVM crash logs written by Gradle when the machine runs out of memory.
hs_err_pid*.log
replay_pid*.log

# Local-only notes, kept out of the public repo.
CLAUDE.md
ROADMAP.md
